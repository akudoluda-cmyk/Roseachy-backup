{
  "name": "roseachy-desk-react-migration",
  "private": true,
  "version": "2.17.2-react-phase3b.4",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "verify:legacy": "node scripts/verify-parity.mjs",
    "verify:phase2": "node scripts/verify-phase2.mjs",
    "verify:phase3": "node scripts/verify-phase3.mjs",
    "test:filter-contract": "node --test tests/filter-contract.test.mjs",
    "test:static": "npm run verify:legacy && npm run verify:phase2 && npm run verify:phase3 && npm run test:filter-contract",
    "test:storage": "python tests/verify-indexeddb.py",
    "test:runtime": "python3 tests/verify-react-runtime.py --mode preview",
    "test:runtime:dev": "python3 tests/verify-react-runtime.py --mode dev",
    "test:unit": "node --test tests/*.test.mjs",
    "test:baseline": "python3 tests/verify-baseline.py",
    "test:forms": "python3 tests/verify-stock-form.py && python3 tests/verify-sales-form.py",
    "test:repository": "python3 tests/verify-repository.py",
    "test:tables": "python3 tests/verify-react-tables.py",
    "test:financial": "python3 tests/verify-baseline.py --financial --credit --backup && python3 tests/verify-baseline.py --financial --credit --backup --mobile",
    "test:cart": "python3 tests/verify-baseline.py --cart && python3 tests/verify-baseline.py --cart --mobile",
    "test:pos": "python3 tests/verify-pos.py && python3 tests/verify-pos.py --mobile",
    "test:supplier": "python3 tests/verify-baseline.py --supplier --backup && python3 tests/verify-baseline.py --supplier --backup --mobile",
    "test:days": "python3 tests/verify-days.py && python3 tests/verify-days.py --mobile",
    "test:day-setup": "python3 tests/verify-day-setup.py"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "vite": "^7.1.0"
  }
}
